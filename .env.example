# Optional catalog path toggles (values come from the CDK stack outputs).
# Leave unset to run with raw-Parquet access only (Path A).

# Path B — S3 Tables native Iceberg REST catalog
#S3_TABLES_ARN=arn:aws:s3tables:<region>:<account-id>:bucket/data-agent-tables

# Path C — same table via the Glue federated catalog
#GLUE_CATALOG=<account-id>:s3tablescatalog/data-agent-tables

# Path D — DuckLake (single-file catalog on S3)
#DUCKLAKE_CATALOG=s3://duckdb-agent-ducklake-<account-id>/catalog/blockchain.ducklake

# Attribution label tables (ofac_addresses + cex_deposit_labels) — enables the
# sanctions-exposure and cash-out attribution steps. Empty = raw ledger only.
#LABELS_PREFIX=s3://duckdb-agent-ducklake-<account-id>/labels

# Engine resource envelope (default 2GB)
#DUCKDB_MEMORY_LIMIT=2GB

# Bedrock model (default: Claude Sonnet via inference profile)
#MODEL_ID=global.anthropic.claude-sonnet-4-6

# Attribution label buckets the agent may read from. Default: only the
# solution-owned bucket (duckdb-agent-ducklake-<account-id>) is accepted, so a
# swapped LABELS_PREFIX cannot point the sanctions screen at someone else's
# data. Set this (comma-separated) only if your labels live elsewhere.
#LABELS_ALLOWED_BUCKETS=my-labels-bucket

# Governance: JSON policy table + default role (see data_agent/governance/policies.py).
# Validated at import: <tenant>:<role> keys, bare-identifier tables/columns,
# row_filter must parse as ONE WHERE predicate, allow_raw_paths cannot be
# combined with governed tables. A malformed table fails the process.
#GOVERNANCE_POLICIES={"exchange-a:junior":{"allow_raw_paths":false,"tables":{"cex_deposit_labels":{"row_filter":"exchange = 'exchange-a'","deny_columns":["subject_identity"]}}}}
# Default role for callers whose claims match no policy. Leave UNSET: the
# built-in floor is deny-all (every statement rejected). Naming an
# unrestricted role here makes "no identity" mean "full access".
#GOVERNANCE_DEFAULT_ROLE=deny-all

# ---- Agent-framework knobs (see docs/design.md). Defaults come from measured production failure modes.
# Result shaping: inline rows/chars caps, materialization cap, LRU of _r_ tables
#MAX_RESULT_ROWS=200
#MAX_RESULT_CHARS=10000
#MAX_MATERIALIZE_ROWS=1000000
#RESULT_TABLE_LRU=100
#SAMPLE_ROWS=3
# History compression: fraction of the model window that triggers stubbing
#COMPRESSION_THRESHOLD=0.6
#MIN_MESSAGES_FOR_STUB=6
#MAX_CONTEXT_MESSAGES=150
# Semantic layer: anchor date for relative metric windows ('last_30d' ends here).
# Per-metric anchors win; metrics without one refuse a relative window unless this
# is set, rather than resolving to today (a static sample dataset reads empty).
# Takes YYYY-MM-DD or YYYY-MM; a monthly metric reads the month containing the day.
#SEMANTIC_ANCHOR=2025-02-24
# Cost policy: explicit-path expansion bound; allowed path schemes
#MAX_EXPANDED_PARTITIONS=366
#RAW_PATH_SCHEMES=s3://
# Data map: partition used to DESCRIBE raw sources; DESCRIBE time budget
#DATAMAP_PROBE_PARTITION=2025-02-21
#DATAMAP_DESCRIBE_BUDGET_S=20
# Audit: EMF audit lines on stdout → CloudWatch metrics under this namespace
#AUDIT_LOG=1
#AUDIT_METRIC_NAMESPACE=DataAgentOnDuckDB
