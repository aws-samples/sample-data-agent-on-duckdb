# Optional catalog path toggles (values come from the CDK stack outputs).
# Leave unset to run with raw-Parquet access only (Path A).

# Path B — S3 Tables native Iceberg REST catalog
#S3_TABLES_ARN=arn:aws:s3tables:<region>:<account-id>:bucket/data-agent-tables

# Path C — same table via the Glue federated catalog
#GLUE_CATALOG=<account-id>:s3tablescatalog/data-agent-tables

# Path D — DuckLake (single-file catalog on S3)
#DUCKLAKE_CATALOG=s3://duckdb-agent-ducklake-<account-id>/catalog/blockchain.ducklake

# Attribution label tables (ofac_addresses + cex_deposit_labels) — enables the
# sanctions-exposure and cash-out attribution steps. Empty = raw ledger only.
#LABELS_PREFIX=s3://duckdb-agent-ducklake-<account-id>/labels

# Engine resource envelope (default 2GB)
#DUCKDB_MEMORY_LIMIT=2GB

# Bedrock model (default: Claude Sonnet via inference profile)
#MODEL_ID=global.anthropic.claude-sonnet-4-6

# Attribution label buckets the agent may read from. Default: only the
# solution-owned bucket (duckdb-agent-ducklake-<account-id>) is accepted, so a
# swapped LABELS_PREFIX cannot point the sanctions screen at someone else's
# data. Set this (comma-separated) only if your labels live elsewhere.
#LABELS_ALLOWED_BUCKETS=my-labels-bucket

# Governance: JSON policy table + default role (see data_agent/governance/policies.py).
# Validated at import: <tenant>:<role> keys, bare-identifier tables/columns,
# row_filter must parse as ONE WHERE predicate, allow_raw_paths cannot be
# combined with governed tables. A malformed table fails the process.
#GOVERNANCE_POLICIES={"exchange-a:junior":{"allow_raw_paths":false,"tables":{"cex_deposit_labels":{"row_filter":"exchange = 'exchange-a'","deny_columns":["subject_identity"]}}}}
# Default role for callers whose claims match no policy. Leave UNSET: the
# built-in floor is deny-all (every statement rejected). Naming an
# unrestricted role here makes "no identity" mean "full access".
#GOVERNANCE_DEFAULT_ROLE=deny-all

# ---- Agent-framework knobs (see docs/design.md). Defaults come from measured production failure modes.
# Result shaping: inline rows/chars caps, materialization cap, LRU of _r_ tables
#MAX_RESULT_ROWS=200
#MAX_RESULT_CHARS=10000
#MAX_MATERIALIZE_ROWS=1000000
#RESULT_TABLE_LRU=100
#SAMPLE_ROWS=3
# History compression: fraction of the model window that triggers stubbing
#COMPRESSION_THRESHOLD=0.6
#MIN_MESSAGES_FOR_STUB=6
#MAX_CONTEXT_MESSAGES=150
# Cost policy: explicit-path expansion bound; allowed path schemes
#MAX_EXPANDED_PARTITIONS=366
#RAW_PATH_SCHEMES=s3://
# Data map: partition used to DESCRIBE raw sources; DESCRIBE time budget
#DATAMAP_PROBE_PARTITION=2025-02-21
#DATAMAP_DESCRIBE_BUDGET_S=20
# Audit: EMF audit lines on stdout → CloudWatch metrics under this namespace
#AUDIT_LOG=1
#AUDIT_METRIC_NAMESPACE=DataAgentOnDuckDB

# ---- Session budget (enforced in the Cost stage as a distinct "budget" refusal;
# 0 = unlimited). A statement is bounded by the partition gate; a SESSION is not.
#SESSION_MAX_STATEMENTS=0
#SESSION_MAX_EXPANDED_PATHS=0
#SESSION_MAX_ENGINE_MS=0
# Text cells the model reads are wrapped as data:«…» (untrusted evidence, never
# instructions). 0 disables the marking.
#RESULT_MARK_STRINGS=1
# Data map: 0 skips the bounded remote DESCRIBE of raw sources (offline runs)
#DATAMAP_PROBE_REMOTE=1
# Cloud-ops scenario: the partition the data map probes (must exist in your exports)
#OPS_PROBE_MONTH=2026-08
#OPS_PROBE_DAY=2026-09-02

# Declared single-node envelope (expanded partition paths); past it the statement is
# refused with a route to a warehouse-scale engine and the equivalent governed SQL (0 = off)
#UPGRADE_ADVICE_PATHS=120

# ---- Lake Formation as the policy authority (optional). Unset = GOVERNANCE_POLICIES only.
#LF_GOVERNANCE={"session_tag":"<tag>","roles":{"<tenant>:<role>":"arn:aws:iam::<account-id>:role/<persona data access role>"},"tables":{"blockchain.eth_traces":{"catalog_id":"<account-id>:s3tablescatalog/<table bucket>","database":"blockchain","name":"eth_traces"}}}
#LF_POLICY_TTL_S=900

# ---- Identity claim paths: set only for a non-Cognito IdP (a set path is authoritative,
# no fallback). Literal claim name first, then dot traversal (e.g. realm_access.roles.0)
#CLAIM_TENANT_PATH=https://idp.example/tenant
#CLAIM_ROLE_PATH=realm_access.roles.0
#CLAIM_SUB_PATH=sub

# ---- Semantic-layer assets (default: semantic/ and verified_queries/ at the repo root)
#SEMANTIC_ASSETS_DIR=semantic
#VERIFIED_QUERIES_DIR=verified_queries

# ---- Extensions: the image bakes them with scripts/install_extensions.py and the
# engine only LOADs. Unset = DuckDB's default directory under the home directory.
#DUCKDB_EXTENSION_DIR=/opt/duckdb-extensions

# ---- MCP surface (a SECOND runtime on the same image, serverProtocol MCP)
#AGENT_SURFACE=mcp
#AGENT_IDENTITY=duckdb_analyst_mcp
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#MCP_STATELESS_HTTP=1

# ---- Outbound sources through AgentCore Gateway (optional). Unset = no
# list_sources / fetch_source tools.
#GATEWAY_MCP_URL=https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
#GATEWAY_TIMEOUT_S=60
#GATEWAY_MAX_TOOL_ROWS=10000
# Targets whose rows are marked degraded (fetched with the gateway's identity, not the caller's)
#GATEWAY_DEGRADED_TOOLS=labels-api

# ---- Client side (UI, scripts/, eval --mode cloud). Never defaults: every value
# names YOUR deployment (CDK stack outputs, `agentcore status`).
#AGENT_REGION=us-west-2
#AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<runtime id>
#AGENT_MCP_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<mcp runtime id>
#COGNITO_POOL_ID=<pool id>
#COGNITO_CLIENT_ID=<app client id>
#COGNITO_CLIENT_SECRET=<app client secret>      # or COGNITO_CLIENT_SECRET_FILE=<path>
#AGENT_LOG_GROUP=/aws/bedrock-agentcore/runtimes/<runtime id>-DEFAULT
# Eval: skip `requires_source` cases whose Gateway target is not deployed (comma-separated)
#EVAL_DEPLOYED_SOURCES=labels-api
