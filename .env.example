# Optional catalog path toggles (values come from the CDK stack outputs).
# Leave unset to run with raw-Parquet access only (Path A).

# Path B — S3 Tables native Iceberg REST catalog
#S3_TABLES_ARN=arn:aws:s3tables:<region>:<account-id>:bucket/data-agent-tables

# Path C — same table via the Glue federated catalog
#GLUE_CATALOG=<account-id>:s3tablescatalog/data-agent-tables

# Path D — DuckLake (single-file catalog on S3)
#DUCKLAKE_CATALOG=s3://duckdb-agent-ducklake-<account-id>/catalog/blockchain.ducklake

# Engine resource envelope (default 2GB)
#DUCKDB_MEMORY_LIMIT=2GB

# Bedrock model (default: Claude Sonnet via inference profile)
#MODEL_ID=global.anthropic.claude-sonnet-4-6

# Governance: JSON policy table + default role (see governance.py docstring)
#GOVERNANCE_POLICIES={"ops:admin":{"allow_raw_paths":true,"tables":{}}}
#GOVERNANCE_DEFAULT_ROLE=ops:admin
